# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:3000

# Database Configuration (Phase 3)
# Local MongoDB: mongodb://localhost:27017/looply
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/looply?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/looply

# Test Database Configuration (Phase 4 Isolated Testing)
# Dedicated test database used exclusively for automated test suites.
# Never use the primary application or production database for testing.
# Local: mongodb://localhost:27017/looply_test
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/looply_test?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb://localhost:27017/looply_test

# Authentication & JWT Configuration (Phase 4)
# High-entropy secret key (minimum 32 characters required in production).
# Generate a cryptographically secure random secret using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or using OpenSSL:
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMTP & Transactional Email Configuration (Phase 5)
# Real SMTP email delivery requires manual setup of valid credentials below.
# If credentials are not configured, automated tests and local development use the
# isolated in-memory test mail outbox without failing registration or password reset.
# In production, valid SMTP credentials are required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Looply <noreply@looply.net>
CLIENT_URL=http://localhost:3000

# Google Gemini AI Configuration (Phase 14)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
# In development and production, GEMINI_API_KEY is required for live generation and improvement.
# Development and production must return HTTP 503 when GEMINI_API_KEY is unavailable.
# Mock responses are permitted ONLY in explicitly enabled test mode (NODE_ENV=test && forceMockMode=true).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
